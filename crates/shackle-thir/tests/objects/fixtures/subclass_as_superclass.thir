enum B_potential = B_occ_0({1}) ++ B_occ_1('..'(B_nb_root_end, '-'(B_bs_root_end, 1))) ++ B_occ_3('..'(1, sum([length((i).kids) | i in T_t_structure])));
array [int] of record('..'(1, 9): x, '..'(1, 9): y): B_objects = '++'('++'(B_nb_objects, B_bs_objects), B_kids_objects);
set of B_potential: B = array_union('++'([B_occ_0({1}), bs], [B_occ_3('..'(1, '-'(T_t_kids_end, B_bs_root_end)))]));
array [B_potential] of string: B_ids = array1d(B_potential, '++'('++'(["nb"], ['++'('++'("bs[", show(p)), "]") | p in '..'(1, card('..'(B_nb_root_end, '-'(B_bs_root_end, 1))))]), ['++'('++'("t.kids[", show(p)), "]") | p in '..'(1, card('..'(1, sum([length((i).kids) | i in T_t_structure]))))]));
array [B_potential] of A_potential: B_to_A :: (no_output) = array1d(B_potential, '++'('++'([A_occ_0(_DECL_1) | _DECL_1 in {1}], [A_occ_1(_DECL_2) | _DECL_2 in '..'(B_nb_root_end, '-'(B_bs_root_end, 1))]), [A_occ_3(_DECL_3) | _DECL_3 in '..'(1, sum([length((i).kids) | i in T_t_structure]))]));
enum A_potential = A_occ_0({1}) ++ A_occ_1('..'(B_nb_root_end, '-'(B_bs_root_end, 1))) ++ A_occ_3('..'(1, sum([length((i).kids) | i in T_t_structure])));
array [int] of record('..'(1, 9): x): A_objects = '++'('++'(A_B_nb_objects, A_B_bs_objects), A_kids_objects);
set of A_potential: A = array_union('++'('++'([A_occ_0({1})], [A_occ_1('..'(B_nb_root_end, '-'(B_bs_root_end, 1)))]), [A_occ_3('..'(1, sum([length((i).kids) | i in T_t_structure])))]));
array [A_potential] of string: A_ids = array1d(A_potential, '++'('++'(["nb"], ['++'('++'("bs[", show(p)), "]") | p in '..'(1, card('..'(B_nb_root_end, '-'(B_bs_root_end, 1))))]), ['++'('++'("t.kids[", show(p)), "]") | p in '..'(1, card('..'(1, sum([length((i).kids) | i in T_t_structure]))))]));
enum T_potential = T_occ_2({1});
array [int] of record(set of B_potential: kids): T_objects = T_t_objects;
set of T_potential: T = T_occ_2({1});
array [T_potential] of string: T_ids = array1d(T_potential, ["t"]);
array [int] of record(int: x, int: y): B_nb_inputs = [(x: 2, y: 2)];
int: B_nb__start = 1;
int: B_nb__end = 2;
int: B_nb_root_start = 1;
int: B_nb_root_end = 2;
array [int] of record('..'(1, 9): x, '..'(1, 9): y): B_nb_objects = B_nb_inputs;
array [int] of record('..'(1, 9): x): A_B_nb_objects = [(x: ('[]'(B_nb_objects, p)).x) | p in index_set(B_nb_objects)];
B_potential: nb_ref :: (no_output) = B_occ_0(1);
array [int] of record(int: x, int: y): B_bs_inputs = [(x: 3, y: 3)];
int: B_bs__start = B_nb__end;
int: B_bs__end = '+'(B_bs__start, 1);
int: B_bs_root_start = B_nb_root_end;
int: B_bs_root_end = '+'(B_bs_root_start, 1);
array [int] of record('..'(1, 9): x, '..'(1, 9): y): B_bs_objects = B_bs_inputs;
array [int] of record('..'(1, 9): x): A_B_bs_objects = [(x: ('[]'(B_bs_objects, p)).x) | p in index_set(B_bs_objects)];
set of B_occ_1('..'(B_nb_root_end, '-'(B_bs_root_end, 1))): bs = B_occ_1('..'(B_nb_root_end, '-'(B_bs_root_end, 1)));
array [int] of record(array [int] of record(int: x, int: y): kids): T_t_inputs = [(kids: [(x: 4, y: 4)])];
array [int] of record(array [int] of bool: kids): T_t_structure = [(kids: [true])];
array [int] of record('..'(1, 9): x, '..'(1, 9): y): B_kids_objects = [k | i in T_t_inputs, k in (i).kids];
array [int] of record('..'(1, 9): x): A_kids_objects = [(x: (k).x) | i in T_t_inputs, k in (i).kids];
int: T_t_kids_A_start = B_bs__end;
int: T_t_kids_A_end = '+'(T_t_kids_A_start, 1);
int: T_t_kids_start = B_bs_root_end;
int: T_t_kids_end = '+'(T_t_kids_start, sum([length((i).kids) | i in T_t_structure]));
array [int] of record(set of B_potential: kids): T_t_objects = [(kids: kids) | p in index_set(T_t_inputs), input = '[]'(T_t_inputs, p), kids = B_occ_3('..'('+'(1, sum([length(('[]'(T_t_inputs, q)).kids) | q in '..'(1, '-'(p, 1))])), '+'(sum([length(('[]'(T_t_inputs, q)).kids) | q in '..'(1, '-'(p, 1))]), length((input).kids))))];
T_potential: t_ref :: (no_output) = T_occ_2(1);
A: a = '[]'(B_to_A, nb_ref);
set of A_potential: s = mzn_injective_image(B, B_to_A);
record(string: id, int: x, int: y): nb :: (output_only) :: ('output') = (id: '[]'(B_ids, nb_ref), x: ('[]'(B_objects, enum2int(nb_ref))).x, y: ('[]'(B_objects, enum2int(nb_ref))).y);
record(string: id, array [int] of record(string: id, int: x, int: y): kids): t :: (output_only) :: ('output') = (id: '[]'(T_ids, t_ref), kids: [(id: '[]'(B_ids, _DECL_4), x: ('[]'(B_objects, enum2int(_DECL_4))).x, y: ('[]'(B_objects, enum2int(_DECL_4))).y) | _DECL_4 in ('[]'(T_objects, enum2int(t_ref))).kids]);
solve satisfy;

enum B_potential = {};
array [int] of record(): B_objects = [];
set of B_potential: B = {};
array [B_potential] of string: B_ids = [];
set of B_potential: B_data_objects = {};
array [B_potential] of A_potential: B_to_A :: (no_output) = [];
enum A_potential = {};
array [int] of record(): A_objects = [];
set of A_potential: A = {};
array [A_potential] of string: A_ids = [];
set of A_potential: A_data_objects = {};
string: a;
A: a_ref = mzn_object_from_id(A_ids, A_data_objects, a, "A", "'a'");
string: b;
B: b_ref = mzn_object_from_id(B_ids, B_data_objects, b, "B", "'b'");
constraint '<'(a_ref, '[]'(B_to_A, b_ref));
constraint '<='(a_ref, '[]'(B_to_A, b_ref));
constraint '>'(a_ref, '[]'(B_to_A, b_ref));
constraint '>='(a_ref, '[]'(B_to_A, b_ref));
solve satisfy;
